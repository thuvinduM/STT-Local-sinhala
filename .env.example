# Copy this file to .env and adjust if needed. All values have sane defaults
# in app/main.py, so .env is optional.

# --- Whisper ---
WHISPER_MODEL=large-v3
# "cuda" to use the GPU, "cpu" to force CPU (slow, testing only)
WHISPER_DEVICE=cuda
# Compute precision on GPU. float16 is the recommended setting for a 2080 Ti.
WHISPER_COMPUTE_TYPE=float16
# Optional: custom directory to cache/download the Whisper model into.
# Leave empty to use the default HuggingFace cache (~/.cache/huggingface).
WHISPER_MODEL_DIR=

# --- Voice Activity Detection / segmentation ---
# Aggressiveness (0-3). Higher = more aggressive at filtering non-speech.
VAD_AGGRESSIVENESS=2
# Rolling window (ms) used to smooth speech/silence decisions - this is
# what stops a short in-sentence pause from splitting one sentence in two.
VAD_PADDING_MS=300
# Fraction of frames in the window that must agree before opening/closing
# a segment (0.9 = 90%).
VAD_TRIGGER_RATIO=0.9
# Segments shorter than this are discarded as noise, not sent to Whisper.
VAD_MIN_SEGMENT_MS=400
# A segment is force-cut if a single speaker talks longer than this
# without pausing, so Whisper never gets an unreasonably huge chunk.
VAD_MAX_SEGMENT_MS=20000

# --- Speaker diarization ---
# Cosine-similarity a new segment must reach against a speaker's stored
# voice prototypes to be considered "the same speaker". Lower = merges
# more aggressively, higher = creates new speakers more easily.
SPEAKER_MATCH_THRESHOLD=0.72
# Segments shorter than this (seconds) never create a *new* speaker on
# their own - their embedding is too unreliable, so they're attached to
# the closest existing speaker instead.
SPEAKER_MIN_ENROLL_SECONDS=0.6
# How many voice "prototypes" to keep per speaker (captures natural voice
# variation instead of relying on a single running average).
SPEAKER_MAX_PROTOTYPES=8

# --- Live preview ---
# How often (seconds) to send a fast, low-quality "partial" preview of
# whatever's currently being spoken, before the segment finalizes.
PARTIAL_UPDATE_INTERVAL_S=2.5
